{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "@/*": [
        "../frontend/src/*"
      ],
      "lucide-react": [
        "../frontend/node_modules/lucide-react"
      ]
    }
  },
  "include": [
    "src",
    "remotion.config.ts"
  ]
}