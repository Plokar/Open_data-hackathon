# =============================================================================
# ZÁPAD GO – produkce (VPS). Zkopírovat do .env, vyplnit CHANGE-ME. Nikdy necommitovat .env!
# =============================================================================

# Doména bez www/api. Traefik z ní skládá api.${DOMAIN} (a www.${DOMAIN} u --profile selfhost).
DOMAIN=CHANGE-ME.cz

# ── Django ────────────────────────────────────────────────────────────────────
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=CHANGE-ME-LONG-RANDOM-STRING
DJANGO_DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings_prod
ALLOWED_HOSTS=api.CHANGE-ME.cz,localhost
CORS_ALLOWED_ORIGINS=https://www.CHANGE-ME.cz,https://CHANGE-ME.cz
CSRF_TRUSTED_ORIGINS=https://www.CHANGE-ME.cz,https://CHANGE-ME.cz
# Cookie sdílená www.* a api.* – bez toho nefunguje přihlášení ani Next proxy (PROJECT_SPEC O1)
AUTH_COOKIE_DOMAIN=.CHANGE-ME.cz
FRONTEND_URL=https://www.CHANGE-ME.cz

# ── Hra ───────────────────────────────────────────────────────────────────────
CHECKIN_RADIUS_M=300
# Jen na demo instanci na pódium! V ostrém provozu False (PROJECT_SPEC 8.3)
DEMO_MODE=False
# Heslo pro `python manage.py seed_demo` (staff účty demo1, demo2)
DEMO_PASSWORD=CHANGE-ME-DEMO-PASSWORD

# ── AI (volitelné, PROJECT_SPEC 11) ───────────────────────────────────────────
AI_PROVIDER=mock
AI_VISION_VERIFY=False
AI_LORE=False
# GEMINI_API_KEY=
# AI_VISION_MODEL=gemini-2.5-flash

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=zapadgo
POSTGRES_USER=zapadgo
POSTGRES_PASSWORD=CHANGE-ME-DB-PASSWORD
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE-ME-REDIS-PASSWORD
REDIS_URL=redis://:CHANGE-ME-REDIS-PASSWORD@redis:6379

# ── E-mail (obnova hesla; bez SMTP stačí console backend) ─────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@CHANGE-ME.cz

# ── Frontend na Vercelu: nastavit v projektu Vercel (Settings → Environment Variables)
# NEXT_PUBLIC_API_URL=https://api.CHANGE-ME.cz
# NEXT_PUBLIC_WS_URL=wss://api.CHANGE-ME.cz
